c (28)
<ElementCONTROL>
labelAnfangsKnoten[] /v_out
labelEndKnoten[] /g_hi/g_lo
enabledShorted 1
parentSheetIdentifier 0
typ 1016
uniqueObjectIdentifier 2005
x 20
y 24
parameter[] 
parameterString[]
nameOpt[]
orientierung 503
idStringDialog PI_PWM_CTRL
<sourceCode>
double f_sw = 25000.0;
double dead_time = 5.0e-7;
double v_meas = xIN[0];
double t_soft = 0.005;
double v_ref = (t < t_soft) ? (320.0 * (t / t_soft)) : 320.0;
double err = v_ref - v_meas;
integral += err * dt * 1.2;
if (integral > 0.25) integral = 0.25;
if (integral < -0.25) integral = -0.25;
duty = (v_ref / 600.0) + 0.0015 * err + integral;
if (duty > 0.90) duty = 0.90;
if (duty < 0.02) duty = 0.02;
double T_sw = 1.0 / f_sw;
double phase = t - Math.floor(t / T_sw) * T_sw;
double t_on = duty * T_sw;
double g_hi = (phase >= dead_time && phase < t_on) ? 1.0 : 0.0;
double g_lo = (phase >= (t_on + dead_time) && phase < (T_sw - dead_time)) ? 1.0 : 0.0;
yOUT[0] = g_hi;
yOUT[1] = g_lo;
return yOUT;

