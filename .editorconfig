# EditorConfig is awesome: https://editorconfig.org
#
# GeckoCIRCUITS Editor Configuration
# Ensures consistent coding style across editors and IDEs.
# Settings below reflect the existing conventions observed across the codebase.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,properties,prp}]
indent_size = 4
max_line_length = 120

[*.{xml,xsd,xsl}]
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml,json}]
indent_size = 2

[*.{css,html,js,ts}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{c,h,cpp,hpp}]
indent_size = 4

[*.{sh,bash}]
indent_size = 4
