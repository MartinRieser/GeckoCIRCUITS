{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Backend Packages (Skip Tests)",
            "type": "shell",
            "command": "mvn",
            "args": [
                "package",
                "-pl",
                "backend/gecko-rest-api,backend/gecko-mcp",
                "-am",
                "-DskipTests",
                "--no-transfer-progress"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Build gecko-simulation-core, gecko-rest-api, and gecko-mcp packages without running tests"
        },
        {
            "label": "Build & Verify All Backend Modules",
            "type": "shell",
            "command": "mvn",
            "args": [
                "verify",
                "--no-transfer-progress"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Compile, test, and verify all Maven modules"
        },
        {
            "label": "Clean Build Directories",
            "type": "shell",
            "command": "mvn",
            "args": [
                "clean",
                "--no-transfer-progress"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Remove Maven target directories across all modules"
        },
        {
            "label": "Run Backend Tests",
            "type": "shell",
            "command": "mvn",
            "args": [
                "test",
                "--no-transfer-progress"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": [
                "$junit"
            ],
            "detail": "Run JUnit tests across all backend modules on Java 25"
        },
        {
            "label": "Run Frontend Tests",
            "type": "shell",
            "command": "npm",
            "args": [
                "--prefix",
                "frontend",
                "test"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Run frontend Vitest suite"
        },
        {
            "label": "Maven: Resolve Dependencies",
            "type": "shell",
            "command": "mvn",
            "args": [
                "dependency:resolve",
                "--no-transfer-progress"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [],
            "detail": "Download and verify Maven dependencies"
        }
    ]
}
