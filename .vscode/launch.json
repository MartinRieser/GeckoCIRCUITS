{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run GeckoCIRCUITS REST API",
            "request": "launch",
            "mainClass": "gecko.rest.GeckoRestApiApplication",
            "projectName": "gecko-rest-api",
            "vmArgs": "-Xmx3G",
            "args": "--gecko.examples-dir=${workspaceFolder}/examples",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Backend Packages (Skip Tests)"
        },
        {
            "type": "java",
            "name": "Run GeckoCIRCUITS REST API (No Build)",
            "request": "launch",
            "mainClass": "gecko.rest.GeckoRestApiApplication",
            "projectName": "gecko-rest-api",
            "vmArgs": "-Xmx3G",
            "args": "--gecko.examples-dir=${workspaceFolder}/examples",
            "console": "integratedTerminal"
        },
        {
            "type": "java",
            "name": "Run GeckoCIRCUITS MCP Server",
            "request": "launch",
            "mainClass": "gecko.mcp.GeckoMcpServer",
            "projectName": "gecko-mcp",
            "vmArgs": "-Xmx2G",
            "args": "",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Backend Packages (Skip Tests)"
        },
        {
            "type": "java",
            "name": "Run Headless Simulation (Current File)",
            "request": "launch",
            "mainClass": "gecko.core.GeckoHeadless",
            "projectName": "gecko-simulation-core",
            "vmArgs": "-Xmx2G",
            "args": "--circuit ${file} --output ${workspaceFolder}/scratch/headless-out.csv",
            "console": "integratedTerminal",
            "preLaunchTask": "Build Backend Packages (Skip Tests)"
        }
    ]
}
